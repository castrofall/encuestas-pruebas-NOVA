# ---------------------------------------------------------------------------
# Feedback Nova - variables de entorno
# Copiar a .env para desarrollo local. NUNCA subir .env al repositorio.
# ---------------------------------------------------------------------------

# Cadena de conexion de Neon (Dashboard de Neon > Connect > Connection string).
# Debe incluir ?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contrasena del panel de respuestas. Minimo 12 caracteres, con mayusculas,
# minusculas, numeros y simbolos (POL-TIC-001). No usar palabras como
# "ternova", "admin" o "administrador".
DASHBOARD_PASSWORD=

# Sal para el hash de IP. Generar con:  node -e "console.log(crypto.randomUUID())"
IP_SALT=

# Dominio de correo permitido para responder el formulario.
DOMINIO_PERMITIDO=ternova.group

# Puerto del servidor local (solo desarrollo).
PORT=3020
